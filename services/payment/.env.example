# Used by `npm run dev -w @food/payment-service` (copy to services/payment/.env). Never commit real keys.
NODE_ENV=development
PORT=4004
LOG_LEVEL=debug
MONGO_URI=mongodb://localhost:27017/payment_db?directConnection=true
# Must match the auth-service secret so customer tokens verify locally.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ISSUER=food-auth-service
JWT_AUDIENCE=food-platform
CORS_ORIGINS=*
RABBITMQ_URL=amqp://food:food-dev-password@localhost:5672
EVENT_EXCHANGE=food.events

# --- Payment provider -------------------------------------------------------
# mock   = local simulated provider (default). No Stripe calls; NOT a Stripe transaction.
# stripe = real Stripe TEST mode. Live keys (sk_live_…) are refused at startup.
PAYMENT_PROVIDER=mock
# Stripe test-mode credentials (Dashboard → Developers → API keys, with "Test mode" on):
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8080/payments/webhook` (whsec_…) or a Dashboard webhook endpoint:
STRIPE_WEBHOOK_SECRET=
# Optional: point the SDK at stripe-mock (http://localhost:12111) for request-shape tests only.
# STRIPE_API_URL=
# Mock provider: secret used to sign its simulated Stripe-format webhooks, and where to deliver them.
MOCK_WEBHOOK_SECRET=whsec_mock_local_development_only
# MOCK_WEBHOOK_URL=http://127.0.0.1:4004/payments/webhook

# POST /payments/:id/simulate — complete payments without a frontend (test cards / mock). Never enable in production.
ENABLE_TEST_ENDPOINTS=true
RECONCILE_INTERVAL_MS=5000
PROVIDER_POLL_AFTER_MS=60000
OUTBOX_POLL_INTERVAL_MS=1000
