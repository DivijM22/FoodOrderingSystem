# Used by `npm run dev -w @food/delivery-service` (copy to services/delivery/.env).
NODE_ENV=development
PORT=4007
LOG_LEVEL=debug
MONGO_URI=mongodb://localhost:27017/delivery_db?directConnection=true
# Must match the auth-service secret so tokens verify locally.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ISSUER=food-auth-service
JWT_AUDIENCE=food-platform
CORS_ORIGINS=*
RABBITMQ_URL=amqp://food:food-dev-password@localhost:5672
EVENT_EXCHANGE=food.events
OUTBOX_POLL_INTERVAL_MS=1000
PREPARATION_DELAY_MS=15000
ASSIGNMENT_DELAY_MS=5000
ASSIGNMENT_RETRY_MS=10000
ASSIGNMENT_MAX_ATTEMPTS=60
ASSIGNMENT_TIMEOUT_MS=600000
WORKER_INTERVAL_MS=1000
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_MAX_ISSUES=3
OTP_RESEND_COOLDOWN_MS=30000
# Secrets: copy the values generated in the root .env by `node scripts/init-env.mjs`.
OTP_HMAC_KEY=
NOTIFICATION_OTP_PUBLIC_KEY=
