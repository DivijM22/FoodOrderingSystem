# Copy to .env and fill in. Never commit .env.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Bootstrap platform administrator created by auth-service on first boot
ADMIN_EMAIL=admin@food.local
ADMIN_PASSWORD=change-me-admin-password1
RABBITMQ_USER=food
RABBITMQ_PASSWORD=food-dev-password
LOG_LEVEL=info
# catalog-service seeds sample restaurants on startup (idempotent)
SEED_ON_START=true

# --- Payment Service (Stage 4) ---
# mock (default): simulated provider, no Stripe calls. stripe: real Stripe TEST mode (live keys are refused).
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=whsec_mock_local_development_only
# Enables POST /payments/:id/simulate (complete payments without a frontend). Never in production.
ENABLE_PAYMENT_TEST_ENDPOINTS=true

# --- Order payment deadline ---
# Unpaid orders are marked "expired" (never deleted) this many seconds after creation.
ORDER_PAYMENT_DEADLINE_SECONDS=900
EXPIRY_SWEEP_INTERVAL_MS=15000

# --- Notification Service (internal; email via SMTP) ---
# Defaults send to the bundled Mailpit (http://localhost:8025). Point these at a real SMTP provider to send real email.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FoodApp <no-reply@food.local>
NOTIFY_MAX_ATTEMPTS=8

# --- Stage 6: generated by `node scripts/init-env.mjs` (leave empty here; never commit real values) ---
# One RabbitMQ user per service (least privilege; provisioned by the rabbitmq-setup job). RABBITMQ_USER above is the admin.
RABBITMQ_AUTH_PASSWORD=
RABBITMQ_CATALOG_PASSWORD=
RABBITMQ_ORDER_PASSWORD=
RABBITMQ_PAYMENT_PASSWORD=
RABBITMQ_BILLING_PASSWORD=
RABBITMQ_DELIVERY_PASSWORD=
RABBITMQ_NOTIFICATION_PASSWORD=
# Read-only broker user of the development console (tools/devtools).
RABBITMQ_DEVTOOLS_PASSWORD=
# Delivery OTP: HMAC key for stored verifiers, and the Notification Service's X25519 key pair (base64 DER) for sealing codes.
OTP_HMAC_KEY=
NOTIFICATION_OTP_PUBLIC_KEY=
NOTIFICATION_OTP_PRIVATE_KEY=
# Shared password of the 12 demo delivery partners created by scripts/seed-delivery-agents.mjs.
DELIVERY_AGENT_PASSWORD=
# Delivery timings (local defaults keep the demo quick).
PREPARATION_DELAY_MS=15000
ASSIGNMENT_DELAY_MS=5000
OTP_TTL_MS=300000
