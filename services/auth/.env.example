# Used by `npm run dev -w @food/auth-service` (copy to services/auth/.env).
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug
MONGO_URI=mongodb://localhost:27017/auth_db?directConnection=true
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ISSUER=food-auth-service
JWT_AUDIENCE=food-platform
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
CORS_ORIGINS=*
ADMIN_EMAIL=admin@food.local
ADMIN_PASSWORD=change-me-admin-password1
