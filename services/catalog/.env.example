# Used by `npm run dev -w @food/catalog-service` (copy to services/catalog/.env).
NODE_ENV=development
PORT=4002
LOG_LEVEL=debug
MONGO_URI=mongodb://localhost:27017/catalog_db?directConnection=true
# Must match the auth-service secret so tokens verify locally.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ISSUER=food-auth-service
JWT_AUDIENCE=food-platform
CORS_ORIGINS=*
SEED_ON_START=true
# Restaurant/menu changes are published as catalog.restaurant.updated.v1 (read model in the Order Service).
RABBITMQ_URL=amqp://food:food-dev-password@localhost:5672
EVENT_EXCHANGE=food.events
OUTBOX_POLL_INTERVAL_MS=1000
# Full snapshots are re-broadcast this often (repairs read models that missed events).
CATALOG_SNAPSHOT_INTERVAL_MS=300000
