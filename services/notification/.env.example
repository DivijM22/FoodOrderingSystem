# Used by `npm run dev -w @food/notification-service` (copy to services/notification/.env).
# Internal-only: no JWT settings, no gateway route; it only consumes events and sends email.
NODE_ENV=development
PORT=4006
LOG_LEVEL=debug
MONGO_URI=mongodb://localhost:27017/notification_db?directConnection=true
RABBITMQ_URL=amqp://food:food-dev-password@localhost:5672
EVENT_EXCHANGE=food.events
# Mailpit (docker compose) captures everything locally; UI at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=10000
MAIL_FROM=FoodApp <no-reply@food.local>
APP_NAME=FoodApp
NOTIFY_MAX_ATTEMPTS=8
SENDER_INTERVAL_MS=2000
SEND_LEASE_MS=60000
# Opens delivery codes sealed by the Delivery Service (copy from the root .env generated by scripts/init-env.mjs).
NOTIFICATION_OTP_PRIVATE_KEY=
