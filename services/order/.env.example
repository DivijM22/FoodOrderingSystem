# Used by `npm run dev -w @food/order-service` (copy to services/order/.env).
NODE_ENV=development
PORT=4003
LOG_LEVEL=debug
MONGO_URI=mongodb://localhost:27017/order_db?directConnection=true
# Must match the auth-service secret so tokens verify locally.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ISSUER=food-auth-service
JWT_AUDIENCE=food-platform
CORS_ORIGINS=*
RABBITMQ_URL=amqp://food:food-dev-password@localhost:5672
EVENT_EXCHANGE=food.events
# Provisional pricing (integer paise): ₹40 delivery, free at ₹499+
DELIVERY_FEE=4000
FREE_DELIVERY_THRESHOLD=49900
OUTBOX_POLL_INTERVAL_MS=1000
# Unpaid orders expire after this many seconds (default 15 minutes); the worker sweeps periodically.
ORDER_PAYMENT_DEADLINE_SECONDS=900
EXPIRY_SWEEP_INTERVAL_MS=15000
EXPIRY_BATCH_SIZE=100
