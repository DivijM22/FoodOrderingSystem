# Used by `npm run dev -w @food/billing-service` (copy to services/billing/.env).
NODE_ENV=development
PORT=4005
LOG_LEVEL=debug
MONGO_URI=mongodb://localhost:27017/billing_db?directConnection=true
# Must match the auth-service secret so tokens verify locally.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ISSUER=food-auth-service
JWT_AUDIENCE=food-platform
CORS_ORIGINS=*
RABBITMQ_URL=amqp://food:food-dev-password@localhost:5672
EVENT_EXCHANGE=food.events
# A discount never reduces the payable amount below this (paise).
MIN_PAYABLE_AMOUNT=100
SEED_DISCOUNTS=true
OUTBOX_POLL_INTERVAL_MS=1000
